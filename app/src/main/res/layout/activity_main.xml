<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <TableLayout
        android:id="@+id/myTableLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:id="@+id/buttonLimpiar"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#A6A6A6"  android:textColor="#000000"
                android:text="AC" />
            <Button
                android:id="@+id/buttonNegativo"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#A6A6A6"  android:textColor="#000000"
                android:text="+/-" />
            <Button
                android:id="@+id/buttonPorcentaje"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#A6A6A6"  android:textColor="#000000"
                android:text="%" />
            <Button
                android:id="@+id/buttonDividir"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#FF9500"  android:text="÷" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:id="@+id/button7"
                android:layout_width="102dp"
                android:layout_height="75dp"
                android:backgroundTint="#333333"  style="@style/Widget.Material3.Button.IconButton.Filled"
                android:text="7" />
            <Button
                android:id="@+id/button8"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#333333"  android:text="8" />

            <Button
                android:id="@+id/button9"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#333333"  android:text="9" />

            <Button
                android:id="@+id/buttonMultiplicar"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#FF9500"  android:text="x" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:id="@+id/button4"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#333333"  android:text="4" />
            <Button
                android:id="@+id/button5"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#333333"  android:text="5" />

            <Button
                android:id="@+id/button6"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#333333"  android:text="6" />

            <Button
                android:id="@+id/buttonResta"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#FF9500"  android:text="-" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:id="@+id/button1"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#333333"  android:text="1" />
            <Button
                android:id="@+id/button2"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#333333"  android:text="2" />

            <Button
                android:id="@+id/button3"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#333333"  android:text="3" />

            <Button
                android:id="@+id/buttonSuma"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#FF9500"  android:text="+" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBorrar"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#333333"  app:icon="@drawable/borrar_ic"
                app:iconTint="@color/white"
                app:iconGravity="textStart">
            </com.google.android.material.button.MaterialButton>


            <Button
                android:id="@+id/button0"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#333333"  android:text="0" />

            <Button
                android:id="@+id/buttonComa"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#333333"  android:text="," />

            <Button
                android:id="@+id/buttonIgual"
                android:layout_width="102dp"
                android:layout_height="75dp"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:backgroundTint="#FF9500"  android:text="=" />
        </TableRow>

    </TableLayout>

    <TextView
        android:id="@+id/textResultado"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:padding="20dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="50sp"
        app:layout_constraintBottom_toTopOf="@id/myTableLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </TextView>


</androidx.constraintlayout.widget.ConstraintLayout>